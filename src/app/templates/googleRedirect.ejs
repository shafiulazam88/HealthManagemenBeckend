<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>
            Google Login
        </title>

    </head>
    <body>
        <div>
            <p>Redirecting to Google...</p>
        </div>
    </body>
    <script>
        (async()=>{
            try {
                const response = await fetch("<%=betterAuthUrl%>/api/auth/sign-in/social",{
                    method:"POST",
                    headers:{
                        "Content-Type":"application/json"
                    },
                    credentials:"include",
                    body:JSON.stringify({
                        provider:"google",
                        callbackURL:"<%=callbackUrl%>"
                    })
                })
                const data = await response.json();
                if(data.url){
                    window.location.href = data.url;
                }
                else {
                // show the error text returned by Better Auth API
                document.body.innerHTML = `<div>
                <p>
                    Error Occurred Redirecting to Google. Please try again later.
                 </p>
                </div>`;
                console.error('Google redirect error:', data);
                }
            } catch (error) {
                document.body.innerHTML=`<div>
                    <p>
                        Error Occurred Redirecting to Google.Please try again later
                    </p>
                </div>`
                console.error('Google redirect fetch error:', error);
            }
        })();
    </script>
</html>
